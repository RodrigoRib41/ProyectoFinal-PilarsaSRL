generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_FRESH")
}

enum UserRole {
  SUPERADMIN
  STOCK
  SERVICES
  FINANZAS
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  role      UserRole @default(STOCK)
}

model Vehiculo {
  id         Int       @id @default(autoincrement())
  patente    String    @unique
  marca      String
  version    String
  año        Int
  kilometros Int
  services   Service[]
}

model Service {
  id                  Int                @id @default(autoincrement())
  vehiculoId          Int
  nombreCliente       String
  telefonoCliente     String
  domicilioCliente    String
  fecha               DateTime           @default(now())
  fechaHoraProgramada DateTime
  descripcion         String
  kilometros          Int
  estado              String             @default("Pendiente")
  vehiculo            Vehiculo           @relation(fields: [vehiculoId], references: [id])
  repuestosUsados     ServicioRepuesto[]
}

model Repuesto {
  id                 Int                @id @default(autoincrement())
  nombre             String
  codigo             String             @unique
  cantidadDisponible Int
  descripcion        String?
  servicios          ServicioRepuesto[]
}

model ServicioRepuesto {
  id         Int      @id @default(autoincrement())
  serviceId  Int
  repuestoId Int
  cantidad   Int
  service    Service  @relation(fields: [serviceId], references: [id])
  repuesto   Repuesto @relation(fields: [repuestoId], references: [id])

  @@unique([serviceId, repuestoId])
}

model Auto {
  id                Int      @id @default(autoincrement())
  marca             String
  modelo            String
  version           String
  año               Int
  precio            Float
  precioPromocional Float?
  moneda            String
  kilometros        Int
  color             String
  categoria         String
  descripcion       String
  foto1             String?
  foto2             String?
  foto3             String?
  foto4             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Balance {
  id         Int            @id @default(autoincrement())
  tipo       TipoMovimiento
  monto      Float
  fecha      DateTime
  marca      String
  modelo     String
  anio       Int
  kilometros Int

  @@map("balance")
}
