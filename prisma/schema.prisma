// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
id Int @id @default(autoincrement())
username String @unique
password String
createdAt DateTime @default(now())
updateAt DateTime @updatedAt
}

model Vehiculo {
  id         Int       @id @default(autoincrement())
  patente    String    @unique
  marca      String
  version    String
  año        Int
  kilometros Int
  services   Service[]
}

model Service {
  id                  Int       @id @default(autoincrement())
  vehiculoId          Int
  nombreCliente       String
  telefonoCliente     String
  domicilioCliente    String
  fecha               DateTime  @default(now())
  fechaHoraProgramada DateTime
  descripcion         String
  kilometros          Int
  estado              String    @default("Pendiente")
  vehiculo            Vehiculo  @relation(fields: [vehiculoId], references: [id])
}



model Auto {
  id          Int      @id @default(autoincrement())
  marca       String
  modelo      String
  version     String
  año         Int
  precio      Float
  precioPromocional Float?
  moneda      String
  kilometros  Int
  color       String
  categoria   String
  descripcion String
  foto1       String?  // Opcional, puede ser null si no subieron foto
  foto2       String?
  foto3       String?
  foto4       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Balance {
  id        Int      @id @default(autoincrement())
  tipo      TipoMovimiento // Enum: 'INGRESO' o 'EGRESO'
  monto     Float
  fecha     DateTime
  marca     String
  modelo    String
  anio      Int
  kilometros Int
  @@map("balance") // Nombre de la tabla en la base de datos (opcional)
}

// Enum para el tipo de movimiento
enum TipoMovimiento {
  INGRESO
  EGRESO
}
